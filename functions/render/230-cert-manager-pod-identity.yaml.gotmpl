# code: language=yaml
#
# cert-manager Route53 PodIdentity — AWS-side DNS-01 plumbing.
#
# Binds the cert-manager ServiceAccount to an IAM role that grants
# Route53 ChangeResourceRecordSets / ListResourceRecordSets /
# ListHostedZonesByName / GetChange — exactly the permissions needed
# for DNS-01 ACME challenges via Route53.
#
# Composed via the aws-pod-identity Configuration package's PodIdentity XR.
#
# Gated on $state.certManager.enabled. The PodIdentity and ClusterIssuer
# share one toggle because they're useless apart — a ClusterIssuer with no
# IAM credentials can't solve challenges, and IAM with no ClusterIssuer
# does nothing.
#
# This stack does NOT install cert-manager itself — that's owned by cert-stack
# (xrs/stacks/k8s/cert/). Override $state.certManager.namespace if your
# cert-stack release runs in a non-default namespace.
#

{{- if $state.certManager.enabled }}
---
apiVersion: aws.hops.ops.com.ai/v1alpha1
kind: PodIdentity
metadata:
  name: {{ $state.name }}-cm
  annotations:
    {{ setResourceNameAnnotation "cm-pod-identity" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  clusterName: {{ $state.clusterName }}
  region: {{ $state.aws.region }}
  providerConfigRef:
    name: {{ $state.aws.providerConfigRef.name }}
    kind: {{ $state.aws.providerConfigRef.kind }}
  {{- if $state.aws.rolePrefix }}
  rolePrefix: {{ $state.aws.rolePrefix }}
  {{- end }}
  {{- if $state.aws.permissionsBoundaryArn }}
  permissionsBoundaryArn: {{ $state.aws.permissionsBoundaryArn }}
  {{- end }}
  serviceAccount:
    name: cert-manager
    namespace: {{ $state.certManager.namespace }}
  inlinePolicy:
    - name: cert-manager-route53
      policy: |
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "route53:GetChange",
              "Resource": "arn:aws:route53:::change/*"
            },
            {
              "Effect": "Allow",
              "Action": [
                "route53:ChangeResourceRecordSets",
                "route53:ListResourceRecordSets"
              ],
              "Resource": "arn:aws:route53:::hostedzone/*"
            },
            {
              "Effect": "Allow",
              "Action": "route53:ListHostedZonesByName",
              "Resource": "*"
            }
          ]
        }
  tags: {{ $state.aws.tags | toJson }}

# ==============================================================================
# Usage: hold the external cert-manager Helm Release until the PodIdentity
# is gone. Deleting the PodIdentity first would yank cert-manager's IAM creds
# while the controller is still running.
# ==============================================================================
{{- if $state.observed.certManager.podIdentityReady }}
---
apiVersion: protection.crossplane.io/v1beta1
kind: Usage
metadata:
  name: {{ $state.name }}-delete-cm-helm-before-pod-identity
  annotations:
    {{ setResourceNameAnnotation "usage-cm-pod-identity" }}
  labels: {{ $state.labels | toJson }}
spec:
  replayDeletion: true
  of:
    apiVersion: aws.hops.ops.com.ai/v1alpha1
    kind: PodIdentity
    resourceRef:
      name: {{ $state.name }}-cm
  by:
    apiVersion: helm.m.crossplane.io/v1beta1
    kind: Release
    resourceRef:
      name: {{ $state.certManager.releaseName }}
{{- end }}
{{- end }}
