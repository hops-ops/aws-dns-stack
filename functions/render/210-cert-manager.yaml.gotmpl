# code: language=yaml
#
# CertManager — Helm Release + AWS Pod Identity (inlined)
#

{{- if $state.certManager.enabled }}

# ==============================================================================
# Helm Release for cert-manager
# ==============================================================================
---
apiVersion: helm.m.crossplane.io/v1beta1
kind: Release
metadata:
  name: {{ $state.certManager.releaseName }}
  annotations:
    {{ setResourceNameAnnotation "helm-release-cert-manager" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    chart:
      name: cert-manager
      repository: https://charts.jetstack.io
      version: v1.19.2
    namespace: {{ $state.certManager.namespace }}
    {{- if gt (len $state.certManager.overrideAllValues) 0 }}
    values:
      {{- toYaml $state.certManager.overrideAllValues | nindent 6 }}
    {{- else }}
    values:
      crds:
        enabled: true
      global:
        leaderElection:
          namespace: {{ $state.certManager.namespace }}
      {{- if $state.certManager.values }}
      {{- toYaml $state.certManager.values | nindent 6 }}
      {{- end }}
    {{- end }}
  rollbackLimit: 3
  providerConfigRef:
    name: {{ $state.helm.providerConfigRef.name }}
    kind: {{ $state.helm.providerConfigRef.kind }}

# ==============================================================================
# AWS Pod Identity for cert-manager Route53 access
# ==============================================================================
---
apiVersion: aws.hops.ops.com.ai/v1alpha1
kind: PodIdentity
metadata:
  name: {{ $state.name }}-cm-pod-identity
  annotations:
    {{ setResourceNameAnnotation "cm-pod-identity" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  clusterName: {{ $state.clusterName }}
  region: {{ $state.aws.region }}
  providerConfigRef:
    name: {{ $state.aws.providerConfigRef.name }}
    kind: {{ $state.aws.providerConfigRef.kind }}
  {{- if $state.aws.rolePrefix }}
  rolePrefix: {{ $state.aws.rolePrefix }}
  {{- end }}
  {{- if $state.aws.permissionsBoundaryArn }}
  permissionsBoundaryArn: {{ $state.aws.permissionsBoundaryArn }}
  {{- end }}
  serviceAccount:
    name: cert-manager
    namespace: {{ $state.certManager.namespace }}
  inlinePolicy:
    - name: cert-manager-route53
      policy: |
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "route53:GetChange",
              "Resource": "arn:aws:route53:::change/*"
            },
            {
              "Effect": "Allow",
              "Action": [
                "route53:ChangeResourceRecordSets",
                "route53:ListResourceRecordSets"
              ],
              "Resource": "arn:aws:route53:::hostedzone/*"
            },
            {
              "Effect": "Allow",
              "Action": "route53:ListHostedZonesByName",
              "Resource": "*"
            }
          ]
        }
  tags: {{ $state.aws.tags | toJson }}

# ==============================================================================
# Usage: Protect PodIdentity from deletion until Helm release is deleted
# ==============================================================================
{{- if and $state.observed.certManager.helmReady $state.observed.certManager.podIdentityReady }}
---
apiVersion: protection.crossplane.io/v1beta1
kind: Usage
metadata:
  name: {{ $state.name }}-delete-cm-helm-before-pod-identity
  annotations:
    {{ setResourceNameAnnotation "usage-cm-pod-identity" }}
  labels: {{ $state.labels | toJson }}
spec:
  of:
    apiVersion: aws.hops.ops.com.ai/v1alpha1
    kind: PodIdentity
    resourceRef:
      name: {{ $state.name }}-cm-pod-identity
  by:
    apiVersion: helm.m.crossplane.io/v1beta1
    kind: Release
    resourceRef:
      name: {{ $state.certManager.releaseName }}
  replayDeletion: true
{{- end }}

{{- end }}
