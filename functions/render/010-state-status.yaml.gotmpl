# code: language=yaml
#
# Compute status values from observed state
#

# ==============================================================================
# Extract observed state from composed resources
# ==============================================================================
{{- $observed := $.observed.resources | default dict }}

# Check if external-dns helm release is ready
{{- $ednsHelmObs := get $observed "helm-release-external-dns" | default dict }}
{{- $ednsHelmResource := $ednsHelmObs.resource | default dict }}
{{- $ednsHelmStatus := $ednsHelmResource.status | default dict }}
{{- $ednsHelmConditions := $ednsHelmStatus.conditions | default list }}
{{- $ednsHelmReady := false }}
{{- range $cond := $ednsHelmConditions }}
  {{- if and (eq $cond.type "Ready") (eq $cond.status "True") }}
    {{- $ednsHelmReady = true }}
  {{- end }}
{{- end }}

# Check if external-dns pod-identity is ready
{{- $ednsPodIdObs := get $observed "edns-pod-identity" | default dict }}
{{- $ednsPodIdResource := $ednsPodIdObs.resource | default dict }}
{{- $ednsPodIdStatus := $ednsPodIdResource.status | default dict }}
{{- $ednsPodIdConditions := $ednsPodIdStatus.conditions | default list }}
{{- $ednsPodIdReady := false }}
{{- range $cond := $ednsPodIdConditions }}
  {{- if and (eq $cond.type "Ready") (eq $cond.status "True") }}
    {{- $ednsPodIdReady = true }}
  {{- end }}
{{- end }}

# Check if cert-manager helm release is ready
{{- $cmHelmObs := get $observed "helm-release-cert-manager" | default dict }}
{{- $cmHelmResource := $cmHelmObs.resource | default dict }}
{{- $cmHelmStatus := $cmHelmResource.status | default dict }}
{{- $cmHelmConditions := $cmHelmStatus.conditions | default list }}
{{- $cmHelmReady := false }}
{{- range $cond := $cmHelmConditions }}
  {{- if and (eq $cond.type "Ready") (eq $cond.status "True") }}
    {{- $cmHelmReady = true }}
  {{- end }}
{{- end }}

# Check if cert-manager pod-identity is ready
{{- $cmPodIdObs := get $observed "cm-pod-identity" | default dict }}
{{- $cmPodIdResource := $cmPodIdObs.resource | default dict }}
{{- $cmPodIdStatus := $cmPodIdResource.status | default dict }}
{{- $cmPodIdConditions := $cmPodIdStatus.conditions | default list }}
{{- $cmPodIdReady := false }}
{{- range $cond := $cmPodIdConditions }}
  {{- if and (eq $cond.type "Ready") (eq $cond.status "True") }}
    {{- $cmPodIdReady = true }}
  {{- end }}
{{- end }}

# Check hosted zone readiness and collect zone IDs
{{- $hostedZones := dict }}
{{- range $d := $state.domains }}
  {{- $sanitized := replace "." "-" $d.name }}
  {{- $key := printf "hosted-zone-%s" $sanitized }}
  {{- $hzObs := get $observed $key | default dict }}
  {{- $hzResource := $hzObs.resource | default dict }}
  {{- $hzAtProvider := ($hzResource.status).atProvider | default dict }}
  {{- $zoneId := $hzAtProvider.zoneId | default "" }}
  {{- $hostedZones = set $hostedZones $d.name (dict "zoneId" $zoneId) }}
{{- end }}

# ==============================================================================
# Compute status output
# ==============================================================================

# Ready state determined by function-auto-ready
{{- $ready := false }}

{{- $state = set $state "observed" (dict
  "externalDNS" (dict
    "helmReady" $ednsHelmReady
    "podIdentityReady" $ednsPodIdReady
  )
  "certManager" (dict
    "helmReady" $cmHelmReady
    "podIdentityReady" $cmPodIdReady
  )
  "hostedZones" $hostedZones
) }}

# Build hosted zones status list
{{- $hostedZonesList := list }}
{{- range $domain, $info := $hostedZones }}
  {{- $hostedZonesList = append $hostedZonesList (dict "domain" $domain "zoneId" ($info.zoneId | default "")) }}
{{- end }}

{{- $state = set $state "status" (dict
  "ready" $ready
  "hostedZones" $hostedZonesList
) }}
